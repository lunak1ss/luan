# 皮皮 AI 项目运营助手 · 云端配置示例（复制为 .env 使用）

# DeepSeek API（默认服务商）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
LLM_PROVIDER=deepseek

# 可选：OpenAI / 本地模型
# OPENAI_API_KEY=
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_PROVIDER=local
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# 云端存储路径（默认 storage/）
PIPI_DATA_DIR=storage/data
PIPI_OUTPUT_DIR=storage/outputs
PIPI_STORAGE_DIR=storage
